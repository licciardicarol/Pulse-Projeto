# Copie para .env e preencha. O .env NUNCA deve ser commitado.

# Base do grupo de API do Xano (autenticação, perfil e conta ficam no mesmo grupo)
XANO_API_URL=https://x8ki-letl-twmt.n7.xano.io/api:tD_FlKAU

# Análise de refeições por IA (Google Gemini) — chave criada no Google AI Studio
GEMINI_API_KEY=
# opcional: modelo do Gemini (padrão gemini-3.5-flash-lite)
GEMINI_MODEL=

# Chave de serviço do Pulse: o MESMO valor precisa estar na variável de ambiente
# PULSE_ANALISE_SECRET do Xano. Protege as gravações de conteúdo gerado por IA:
# PATCH refeicoes/me/{refeicao_id}/analise e POST recomendacoes/me
PULSE_ANALISE_SECRET=
